{
  "manifest_version": 3,
  "name": "Docs Noir — Google Docs Dark Mode",
  "short_name": "Docs Noir",
  "version": "1.2.0",
  "description": "A polished, customizable dark mode for Google Docs — presets, sliders, and creative themes.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Docs Noir",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://docs.google.com/document/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": [
        "lib/browser.js",
        "lib/presets.js",
        "lib/storage.js",
        "content/theme-engine.js",
        "content/content.js"
      ],
      "css": ["content/docs-theme.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "docs-noir@local.dev",
      "strict_min_version": "121.0"
    }
  }
}
